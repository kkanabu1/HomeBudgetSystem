@{
    ViewData["Title"] = "Dashboard";
}

<h1>Financial Dashboard</h1>

<div class="row mt-4">

    <div class="col-md-3">
        <div class="card p-3 shadow-sm">
            <h5>Total Income</h5>
            <h2>@ViewBag.TotalIncome zł</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3 shadow-sm">
            <h5>Total Expenses</h5>
            <h2>@ViewBag.TotalExpenses zł</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3 shadow-sm">
            <h5>Monthly Expenses</h5>
            <h2>@ViewBag.MonthlyExpenses zł</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3 shadow-sm">
            <h5>Balance</h5>
            <h2>@ViewBag.Balance zł</h2>
        </div>
    </div>

    <div class="row mt-3">

        <div class="col-md-3">
            <div class="card p-3 shadow-sm">

                <h5>Planned Expenses</h5>

                <h3>
                    @ViewBag.PlannedExpenses zł
                </h3>

            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3 shadow-sm">

                <h5>Expense Difference</h5>

                <h3>
                    @ViewBag.ExpenseDifference zł
                </h3>

            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3 shadow-sm">

                <h5>Forecast Expenses</h5>

                <h3>
                    @ViewBag.ForecastExpenses zł
                </h3>

            </div>
        </div>
    </div>

</div>

<div class="mt-3">

    @if (ViewBag.BudgetWarning != null)
    {
        var alertClass = ViewBag.ExpenseDifference < 0
            ? "alert alert-danger"
            : "alert alert-success";

        <div class="@alertClass">

            <strong>
                @ViewBag.BudgetWarning
            </strong>

        </div>
    }

</div>

<h3 class="mt-5">Recent Transactions</h3>

<table class="table table-striped mt-3">
    <thead>
        <tr>
            <th>Date</th>
            <th>Description</th>
            <th>Category</th>
            <th>Type</th>
            <th>Amount</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in ViewBag.RecentTransactions)
        {
            <tr>
                <td>@item.Date.ToShortDateString()</td>
                <td>@item.Description</td>
                <td>@item.Category?.Name</td>
                <td>@(item.IsIncome ? "Income" : "Expense")</td>
                <td>@item.Amount zł</td>
            </tr>
        }

    </tbody>

</table>

<div class="mt-5" style="max-width: 600px;">
    <h3>Overall Expenses by Category</h3>

    <canvas id="expenseChart"></canvas>
</div>

<div class="mt-5" style="max-width: 600px;">

    <h3>Monthly Expenses by Category</h3>

    <canvas id="monthlyExpenseChart"></canvas>

</div>

<p class="mt-4">

    <a class="btn btn-primary"
       asp-controller="Transactions"
       asp-action="Create">
        Add Transaction
    </a>

    <a class="btn btn-secondary"
       asp-controller="Categories"
       asp-action="Index">
        Manage Categories
    </a>

</p>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const ctx = document.getElementById('expenseChart');

    const expenseChart = new Chart(ctx, {
        type: 'pie',
        data: {
        labels: @Html.Raw(Json.Serialize(ViewBag.ChartLabels)),
        datasets: [{
            label: 'Expenses',
            data: @Html.Raw(Json.Serialize(ViewBag.ChartData)),
            borderWidth: 1
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: true
        }
    });

    const monthlyCtx = document.getElementById('monthlyExpenseChart');

    const monthlyExpenseChart = new Chart(monthlyCtx, {
        type: 'pie',
        data: {
            labels: @Html.Raw(Json.Serialize(ViewBag.MonthlyChartLabels)),
            datasets: [{
            label: 'Monthly Expenses',
            data: @Html.Raw(Json.Serialize(ViewBag.MonthlyChartData)),
            borderWidth: 1
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: true
        }
    });
</script>